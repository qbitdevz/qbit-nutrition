{
  "expo": {
    "name": "Qbit Nutrition",
    "slug": "qbit-nutrition",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "qbitnutrition",
    "userInterfaceStyle": "automatic",
    "android": {
      "allowBackup": false,
      "package": "dev.qbitdev.nutrition",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#04070D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "android.permission.health.WRITE_NUTRITION",
        "android.permission.health.READ_WEIGHT"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#04070D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-localization",
      "expo-sqlite",
      "expo-asset",
      "expo-font",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Qbit Nutrition uses the camera to photograph your meals and to read product barcodes. A photo leaves your phone only when you choose to analyze it. Reading a barcode takes no photo.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "cameraPermission": "Qbit Nutrition uses the camera only to photograph your meals. A photo leaves your phone only when you choose to analyze it.",
          "microphonePermission": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
