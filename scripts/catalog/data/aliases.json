[
  {"match": "^Beef, ground\\b", "en": ["ground beef", "minced beef", "hamburger meat"], "es": ["carne molida", "carne picada", "carne molida de res", "carne picada de ternera"]},
  {"match": "^(Potato|Potatoes)\\b.*french fr(y|ied|ies)|french fries", "en": ["french fries", "fries"], "es": ["papas fritas", "patatas fritas"]},
  {"match": "^Egg, whole, cooked, scrambled|^Egg, scrambled|^Eggs?, scrambled", "en": ["scrambled eggs"], "es": ["huevos revueltos"]},
  {"match": "^Egg, whole, cooked, fried|^Egg, fried", "en": ["fried egg"], "es": ["huevo frito"]},
  {"match": "^Egg, whole, cooked, hard-boiled", "en": ["hard boiled egg", "boiled egg"], "es": ["huevo duro", "huevo cocido", "huevo hervido"]},
  {"match": "^Chicken, broilers? or fryers?, breast", "es": ["pechuga de pollo"]},
  {"match": "^Chicken, broilers? or fryers?, thigh", "es": ["muslo de pollo"]},
  {"match": "^Chicken (fillet|patty), breaded", "en": ["chicken cutlet", "breaded chicken cutlet"], "es": ["suprema de pollo", "escalope de pollo empanizado"]},
  {"match": "^Chicken, (broilers? or fryers?|breast).*(coated|breaded|fried)", "es": ["pollo frito", "pollo empanizado"]},
  {"match": "^Veal.*cutlet", "es": ["milanesa de ternera", "escalope de ternera"]}
]
